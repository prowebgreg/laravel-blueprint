################################################################################
# Blueprint CMS - Environment Configuration
# See spec: specs/002-system-foundation/spec.md
################################################################################

APP_NAME="Blueprint CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################################################################
# Database Configuration (PostgreSQL 17 via Laravel Sail)
# Volume: sail-pgsql mounted to /var/lib/postgresql/data
################################################################################
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=blueprint_db
DB_USERNAME=sail
DB_PASSWORD=password

################################################################################
# Session Configuration
# 2-hour inactivity timeout (measured from last request)
################################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

################################################################################
# Filesystem Configuration
# Switch between 'local' (development) and 's3' (production)
# Local storage requires minimum 1GB available disk space
################################################################################
FILESYSTEM_DISK=local

################################################################################
# Queue Configuration (Redis via Laravel Sail)
# Volume: sail-redis mounted to /data
################################################################################
QUEUE_CONNECTION=redis

################################################################################
# Cache Configuration (Redis via Laravel Sail)
################################################################################
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

################################################################################
# Redis Configuration (Redis 7 via Laravel Sail)
################################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

################################################################################
# Mail Configuration (Mailpit via Laravel Sail)
# Web UI accessible at http://localhost:8025
# SMTP accessible at localhost:1025 (forwarded from container)
################################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@blueprint-cms.local"
MAIL_FROM_NAME="${APP_NAME}"

################################################################################
# AWS S3 Cloud Storage Configuration
# Bucket: laravel-blueprint-assets (us-west-1)
# CDN: https://dxrnpyjkukgbc.cloudfront.net
# Required IAM permissions: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket
################################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-1
AWS_BUCKET=laravel-blueprint-assets
AWS_URL=https://dxrnpyjkukgbc.cloudfront.net
AWS_USE_PATH_STYLE_ENDPOINT=false

################################################################################
# Laravel Sail Configuration
# Sail service orchestration and Docker environment settings
# Note: Sail uses APP_PORT for web access. For manual 'php artisan serve', use --port=3010
################################################################################
SAIL_XDEBUG_MODE=off
APP_PORT=80
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
# WWWGROUP=1000
# WWWUSER=1000

################################################################################
# Vite Configuration
################################################################################
VITE_APP_NAME="${APP_NAME}"

################################################################################
# Development Seeds Configuration
# Used by database seeders in local/development environments only
################################################################################
DEFAULT_ADMIN_PASSWORD=
