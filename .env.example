################################################################################
# Blueprint CMS - Environment Configuration
# See spec: specs/002-system-foundation/spec.md
################################################################################

################################################################################
# Application Core Configuration
# Controls fundamental application behavior and identity
################################################################################

# Application name (displayed in admin panel, emails, etc.)
APP_NAME="Blueprint CMS"

# Environment: local, staging, production
# Affects error handling, caching behavior, and debug output
APP_ENV=local

# Application encryption key (auto-generated via: php artisan key:generate)
# CRITICAL: Never commit actual key to version control
APP_KEY=

# Enable/disable detailed error messages and debug toolbar
# MUST be false in production for security
APP_DEBUG=true

# Base URL for the application (used for asset URLs, emails, redirects)
# Production example: https://example.com
APP_URL=http://localhost

################################################################################
# Localization Configuration
################################################################################

# Default application locale (ISO 639-1 code)
APP_LOCALE=en

# Fallback locale when translations missing
APP_FALLBACK_LOCALE=en

# Locale for Faker library in seeders/factories
APP_FAKER_LOCALE=en_US

################################################################################
# Maintenance Mode Configuration
################################################################################

# Driver for maintenance mode storage: file or cache
# 'file' stores in storage/framework/maintenance.php
APP_MAINTENANCE_DRIVER=file

# Alternative: use cache/database for distributed systems
# APP_MAINTENANCE_STORE=database

################################################################################
# PHP Server Configuration
################################################################################

# Number of workers for built-in PHP server (rarely needed with Sail)
# PHP_CLI_SERVER_WORKERS=4

################################################################################
# Security Configuration
################################################################################

# Bcrypt hashing rounds (10-12 recommended, higher = slower but more secure)
# Default 12 provides good security/performance balance
BCRYPT_ROUNDS=12

################################################################################
# Logging Configuration
################################################################################

# Primary log channel: stack, single, daily, slack, syslog, errorlog
LOG_CHANNEL=stack

# Channels to use when LOG_CHANNEL=stack
LOG_STACK=single

# Channel for deprecation warnings (null = use LOG_CHANNEL)
LOG_DEPRECATIONS_CHANNEL=null

# Minimum log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

################################################################################
# Database Configuration (PostgreSQL 17 via Laravel Sail)
# Volume: sail-pgsql mounted to /var/lib/postgresql/data
# Data persists across container restarts
################################################################################

# Database driver: pgsql, mysql, sqlite, sqlsrv
DB_CONNECTION=pgsql

# Database host (use 'pgsql' for Sail, '127.0.0.1' for local PostgreSQL)
DB_HOST=pgsql

# Database port (PostgreSQL default: 5432, MySQL: 3306)
DB_PORT=5432

# Database name (created automatically by Sail on first run)
DB_DATABASE=blueprint_db

# Database username (Sail default: 'sail')
DB_USERNAME=sail

# Database password (change in production, store securely)
DB_PASSWORD=password

################################################################################
# Session Configuration
# 2-hour inactivity timeout (measured from last request)
################################################################################

# Session storage driver: file, cookie, database, apc, memcached, redis, array
# 'database' recommended for production (requires sessions table migration)
SESSION_DRIVER=database

# Session lifetime in minutes (120 = 2 hours)
# User logged out after this period of inactivity
SESSION_LIFETIME=120

# Encrypt session data (false for better performance, true for sensitive data)
SESSION_ENCRYPT=false

# Session cookie path (/ = entire domain)
SESSION_PATH=/

# Session cookie domain (null = current domain only)
# Set to '.example.com' for subdomain sharing
SESSION_DOMAIN=null

################################################################################
# Broadcasting Configuration
################################################################################

# Broadcast driver: log, redis, pusher, ably, null
# 'log' writes events to log file for development
BROADCAST_CONNECTION=log

################################################################################
# Filesystem Configuration
# Switch between 'local' (development) and 's3' (production)
# Local storage requires minimum 1GB available disk space
################################################################################

# Default filesystem disk: local, public, s3
# 'local' for development, 's3' for production (offload assets to CloudFront)
FILESYSTEM_DISK=local

################################################################################
# Queue Configuration (Redis via Laravel Sail)
# Volume: sail-redis mounted to /data
# Jobs persist across container restarts
################################################################################

# Queue connection driver: sync, database, beanstalkd, sqs, redis
# 'redis' required for Laravel Horizon monitoring
QUEUE_CONNECTION=redis

################################################################################
# Cache Configuration (Redis via Laravel Sail)
# Improves performance by caching database queries, views, routes, config
################################################################################

# Cache store driver: apc, array, database, file, memcached, redis
# 'redis' recommended for production performance
CACHE_STORE=redis

# Optional cache key prefix (prevents key collisions in shared Redis)
# CACHE_PREFIX=

################################################################################
# Memcached Configuration
# Legacy cache option, not actively used (Redis preferred)
################################################################################

# Memcached server host
MEMCACHED_HOST=127.0.0.1

################################################################################
# Redis Configuration (Redis 7 via Laravel Sail)
# Used for caching, sessions, queues, and Horizon
# Volume: sail-redis mounted to /data
################################################################################

# Redis client: phpredis (PHP extension, faster) or predis (pure PHP)
# 'phpredis' recommended for production performance
REDIS_CLIENT=phpredis

# Redis host (use 'redis' for Sail, '127.0.0.1' for local Redis)
REDIS_HOST=redis

# Redis password (null for no auth, set password in production)
REDIS_PASSWORD=null

# Redis port (default: 6379)
REDIS_PORT=6379

################################################################################
# Mail Configuration (Mailpit via Laravel Sail)
# Web UI accessible at http://localhost:8025 - view all sent emails
# SMTP accessible at localhost:1025 (forwarded from container)
# In production, switch to smtp, ses, mailgun, postmark, sendmail, or log
################################################################################

# Mail driver: smtp, ses, mailgun, postmark, sendmail, log, array
# 'smtp' with Mailpit for local development (catches all outgoing emails)
MAIL_MAILER=smtp

# Mail transport scheme (null, tls, ssl) - Mailpit doesn't require encryption
MAIL_SCHEME=null

# SMTP server host (use 'mailpit' for Sail, production SMTP server otherwise)
MAIL_HOST=mailpit

# SMTP server port (Mailpit: 1025, production TLS: 587, SSL: 465)
MAIL_PORT=1025

# SMTP authentication username (null for Mailpit, required for production SMTP)
MAIL_USERNAME=null

# SMTP authentication password (null for Mailpit, required for production SMTP)
MAIL_PASSWORD=null

# Encryption method: null, tls, ssl (null for Mailpit, 'tls' for most production)
MAIL_ENCRYPTION=null

# Default 'from' email address for all outgoing emails
MAIL_FROM_ADDRESS="admin@blueprint-cms.local"

# Default 'from' name for all outgoing emails
MAIL_FROM_NAME="${APP_NAME}"

################################################################################
# AWS S3 Cloud Storage Configuration
# Used for offloading media assets to cloud storage with CloudFront CDN delivery
# Bucket: laravel-blueprint-assets (us-west-1)
# CDN: https://dxrnpyjkukgbc.cloudfront.net
# Required IAM permissions: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket
################################################################################

# AWS IAM access key ID (obtain from AWS IAM console)
# CRITICAL: Never commit actual credentials to version control
AWS_ACCESS_KEY_ID=

# AWS IAM secret access key (obtain from AWS IAM console)
# CRITICAL: Keep this secret secure, rotate regularly
AWS_SECRET_ACCESS_KEY=

# AWS region where S3 bucket is located (e.g., us-west-1, us-east-1, eu-west-1)
AWS_DEFAULT_REGION=us-west-1

# S3 bucket name for storing uploaded media and assets
AWS_BUCKET=laravel-blueprint-assets

# CloudFront distribution URL for serving assets (faster delivery via CDN)
# Leave blank to use direct S3 URLs (slower, not recommended for production)
AWS_URL=https://dxrnpyjkukgbc.cloudfront.net

# Use path-style endpoint (false for virtual-hosted style, true for legacy)
# Modern S3 uses virtual-hosted style (bucket.s3.region.amazonaws.com)
AWS_USE_PATH_STYLE_ENDPOINT=false

################################################################################
# Laravel Horizon Configuration
# Queue monitoring and management dashboard for Redis queues
# Dashboard accessible at /horizon (requires authentication)
################################################################################

# Optional: Custom name for Horizon instance (shown in UI and notifications)
# Useful when running multiple Horizon instances
# HORIZON_NAME=

# Optional: Subdomain for Horizon dashboard (null = same domain as app)
# HORIZON_DOMAIN=

# Optional: URI path for Horizon dashboard (default: 'horizon')
# HORIZON_PATH=horizon

# Optional: Redis key prefix for Horizon data (auto-generated from APP_NAME)
# Only set when running multiple Horizon installations on same Redis server
# HORIZON_PREFIX=

################################################################################
# Laravel Sail Configuration
# Sail service orchestration and Docker environment settings
# Controls port forwarding from Docker containers to host machine
# Note: Sail uses APP_PORT for web access. For manual 'php artisan serve', use --port=3010
################################################################################

# Xdebug mode: off, develop, coverage, debug, profile, trace
# 'off' for normal development (better performance), 'debug' for step debugging
SAIL_XDEBUG_MODE=off

# Port for accessing the application on host machine (http://localhost:APP_PORT)
# Default 80 allows http://localhost access
APP_PORT=80

# Port forwarding for PostgreSQL database (host:container)
# Access database from host using localhost:5432
FORWARD_DB_PORT=5432

# Port forwarding for Redis server (host:container)
# Access Redis from host using localhost:6379
FORWARD_REDIS_PORT=6379

# Port forwarding for Mailpit SMTP server (host:container)
# SMTP connections from host use localhost:1025
FORWARD_MAILPIT_PORT=1025

# Port forwarding for Mailpit web UI (host:container)
# Access Mailpit dashboard at http://localhost:8025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Linux users: Set to match your user/group ID to avoid permission issues
# Run `id -u` and `id -g` to find your UID and GID
# WWWGROUP=1000
# WWWUSER=1000

################################################################################
# Vite Configuration
# Frontend asset bundling and hot module replacement (HMR)
################################################################################

# Application name exposed to frontend JavaScript
# Available in JS via import.meta.env.VITE_APP_NAME
VITE_APP_NAME="${APP_NAME}"

################################################################################
# Development Seeds Configuration
# Used by database seeders in local/development environments only
# NEVER use in production
################################################################################

# Default password for seeded admin user accounts in development
# Leave empty in production, only set for local development convenience
DEFAULT_ADMIN_PASSWORD=
